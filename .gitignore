# Ignore everything by default, then explicitly allow only what should be pushed.
*
!.gitignore
!requirements.txt
!apriltag_centering/
!apriltag_centering/**
apriltag_centering/track_moving_apriltag.py
apriltag_centering/track_stationary_apriltag.py
!hand_control/
!hand_control/**
!audio/
!audio/**
!mqttlib.py
!table_tennis/
!table_tennis/**
table_tennis/results.log
!sumo_control/
!sumo_control/**
!gait_identifier/
!gait_identifier/**
!step_counter/
!step_counter/**
!impenetrable_safe/
!impenetrable_safe/**
# camera pictures are big: keep them on the laptop only
step_counter/data/video/
impenetrable_safe/safe_lock/data/
impenetrable_safe/safe_lock/removed/
# the vault picture is from the films: keep it on the laptop only
impenetrable_safe/safe_lock/assets/vault.jpg
# the explainer video is big; make_video.py can always re-make it
impenetrable_safe/safe_lock/explainer/*.mp4
# made by the scripts (train.py, check_numpy_net.py), not hand-written
impenetrable_safe/safe_lock/mistakes.jpg
impenetrable_safe/safe_lock/model.npz
impenetrable_safe/**/.DS_Store

# Re-ignore compiled bytecode caches everywhere, even inside the folders
# whitelisted above -- machine/version-specific, never worth tracking.
**/__pycache__/